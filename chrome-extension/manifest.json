{
  "manifest_version": 3,
  "name": "CreatorMetrics LTK Token Manager",
  "version": "1.0.0",
  "description": "Automatically captures and manages LTK tokens from creator.shopltk.com",
  "permissions": [
    "storage",
    "webRequest",
    "tabs"
  ],
  "host_permissions": [
    "https://creator.shopltk.com/*",
    "https://api-gateway.rewardstyle.com/*",
    "https://creator-auth.shopltk.com/*",
    "https://creatotmetrics.vercel.app/*",
    "https://web-production-7199b.up.railway.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://creator.shopltk.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["https://creator.shopltk.com/*"]
    }
  ]
}
